# Ansible AWX Environment Configuration
# Copy this file to .env and update the values for production use

# Database Configuration
# SECURITY: Change this to a strong password in production!
AWX_DB_PASSWORD=awxpass

# AWX Secret Key
# SECURITY: Generate a random secret key for production!
# Example: openssl rand -base64 32
AWX_SECRET_KEY=awxsecret123456789

# AWX Admin Credentials
# SECURITY: Change the default admin password!
AWX_ADMIN_USER=admin
AWX_ADMIN_PASSWORD=admin

# PRODUCTION SETUP INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Generate strong passwords:
#    - AWX_DB_PASSWORD: openssl rand -base64 24
#    - AWX_SECRET_KEY: openssl rand -base64 32
# 3. Update AWX_ADMIN_PASSWORD with a strong password
# 4. Secure the .env file: chmod 600 .env
# 5. Start AWX: docker-compose up -d
